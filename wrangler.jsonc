{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "visago-maroc",
  "main": "./worker.js",
  "compatibility_date": "2026-09-17",

  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visago-maroc-db",
      "database_id": "ab6bbe35-d583-4edb-8d89-769da17b7280"
    }
  ]
}
